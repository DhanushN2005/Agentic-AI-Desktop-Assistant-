{
  "manifest_version": 3,
  "name": "Flexie Browser Assistant",
  "version": "2.0.0",
  "description": "Voice and AI-powered browser copilot for webpage analysis, summarization, automation, and research.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8768/*",
    "http://localhost:8768/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flexie"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
