# Flexie 2.0 Environment Configuration — All AI Provider Keys & Models (configurable via UI: 🔑 AI KEYS)
# Get keys from: groq=console.groq.com/keys | gemini=aistudio.google.com/app/apikey | openai=platform.openai.com/api-keys | deepseek=platform.deepseek.com/api_keys | anthropic=console.anthropic.com/settings/keys | mistral=console.mistral.ai/api-keys

# --- API Keys (any one is enough, fallback chain: Groq → OpenAI → DeepSeek → Gemini → Claude → Mistral → Ollama) ---
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
MISTRAL_API_KEY=your_mistral_key_here
COHERE_API_KEY=your_cohere_key_here
TOGETHER_API_KEY=your_together_key_here

# --- Models (pick from available list per provider — also configurable in UI model dropdown) ---
# Sep 2026: Groq decommissioned llama-* → use openai/gpt-oss-20b, qwen/qwen3-32b, kimi-k2 etc.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MISTRAL_MODEL=mistral-small-latest
# Active provider: auto (fallback chain) or force one: groq | openai | deepseek | gemini | anthropic | mistral | ollama
ACTIVE_PROVIDER=auto
FLEXIE_CONVERSATION_HISTORY_TURNS=8
FLEXIE_CONVERSATION_HISTORY_CHARS=8000
FLEXIE_ROUTING_CONTEXT_TURNS=5
FLEXIE_LLM_REQUEST_TIMEOUT=15
FLEXIE_CODE_MAX_TOKENS=4096
FLEXIE_ARTIFACT_SOURCE_CHARS=20000
FLEXIE_VOICE_LISTEN_TIMEOUT=7
FLEXIE_CODE_OUTPUT_DIR=~/Downloads
FLEXIE_ARTIFACT_BACKUP_DIR=./context/artifact_backups

# --- Local LLM ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=tinyllama:latest

# --- Email ---
FLEXIE_EMAIL=your_email_here
FLEXIE_PASS=your_app_password_here
